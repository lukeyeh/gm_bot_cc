# Ignore all bazel-* symlinks. There is no full list since this can change
# based on the name of the directory bazel is cloned into.
/bazel-*

# Generated by `bazel run :compile_commands`.
/compile_commands.json
/external

# clangd index.
/.cache/

# direnv.
/.direnv/

# Output of `nix build`.
/result

# Profiling output: recordings from perf, pictures from flamegraph, and
# profiles saved by samply.
/flamegraph.svg
/perf.data*
/profile.json*

# The bot's data and secrets, when it is run from here.
/gm.db*
/.env

# Reports written while tuning performance, for reading rather than keeping.
/perf-reports/
