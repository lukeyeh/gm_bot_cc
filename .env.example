# Copy to .env and fill in. direnv loads it; see the README for running
# without direnv.

# The bot's token, from the Discord Developer Portal. Required.
DISCORD_TOKEN=

# The GM channels: where a GM counts and anything else resets its author's
# streak. One per server the bot serves, separated by commas. Required.
GM_CHANNEL_IDS=

# Whose midnight separates one day from the next. UTC if empty.
TIMEZONE=America/New_York

# Where to keep gm.db. Give an absolute path when using `bazel run`, which
# starts the bot somewhere inside Bazel's output tree.
DATA_DIR=
